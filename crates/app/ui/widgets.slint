// Small building blocks used throughout.

import { Theme, Icons } from "theme.slint";

// The tooltip shown for the control under the pointer; drawn by the window.
export global Tip {
    in-out property <string> text;
    // Where it points: the bottom centre of the control.
    in-out property <length> x;
    in-out property <length> y;
}

export component Icon inherits Path {
    in property <string> icon;
    in property <color> color: Theme.text-muted;
    commands: icon;
    fill: color;
    viewbox-width: 24;
    viewbox-height: 24;
    width: 18px;
    height: 18px;
}

// A square button showing only an icon.
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <color> tint: Theme.text-muted;
    in property <bool> active;
    in property <bool> enabled: true;
    in property <length> size: 32px;
    in property <length> icon-size: 18px;
    // Shown after a moment under the pointer.
    in property <string> tooltip;
    callback clicked();
    width: size;
    height: size;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: Theme.radius;
    background: touch.pressed ? Theme.selected-strong : (touch.has-hover && enabled) || active ? Theme.hover : transparent;
    opacity: enabled ? 1 : 0.4;
    Icon {
        icon: root.icon;
        color: root.active ? Theme.accent : root.tint;
        width: root.icon-size;
        height: root.icon-size;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            Tip.text = "";
            root.clicked();
        }
    }
    // Once per visit of the pointer.
    property <bool> tip-shown;
    Timer {
        interval: 600ms;
        running: touch.has-hover && root.tooltip != "" && !root.tip-shown;
        triggered => {
            root.tip-shown = true;
            Tip.x = root.absolute-position.x + root.width / 2;
            Tip.y = root.absolute-position.y + root.height;
            Tip.text = root.tooltip;
        }
    }
    out property <bool> hovered: touch.has-hover;
    changed hovered => {
        if (!self.hovered) {
            root.tip-shown = false;
            if (Tip.text == root.tooltip) {
                Tip.text = "";
            }
        }
    }
}

// An icon with a label, for toolbars.
export component ToolButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <color> tint: Theme.text;
    in property <bool> enabled: true;
    in property <bool> primary;
    // A switch that is on.
    in property <bool> active;
    // Only the icon, the label as a tooltip: for toolbars short of room.
    in property <bool> compact;
    // Shown after a moment under the pointer; the label when compact.
    in property <string> tooltip;
    property <bool> iconic: root.compact && root.icon != "";
    callback clicked();
    height: 32px;
    min-width: root.iconic ? 32px : 0px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: Theme.radius;
    background: primary ? (touch.has-hover ? Theme.accent-hover : Theme.accent)
        : touch.pressed || active ? Theme.selected-strong : touch.has-hover && enabled ? Theme.hover : transparent;
    opacity: enabled ? 1 : 0.4;
    HorizontalLayout {
        padding-left: root.iconic ? 7px : 8px;
        padding-right: root.iconic ? 7px : 10px;
        spacing: 6px;
        alignment: root.iconic ? center : start;
        if root.icon != "": Icon {
            y: (parent.height - self.height) / 2;
            icon: root.icon;
            color: root.primary ? Theme.on-accent : root.tint;
        }
        if !root.iconic: Text {
            text: root.label;
            color: root.primary ? Theme.on-accent : root.tint;
            font-size: Theme.font-size;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            Tip.text = "";
            root.clicked();
        }
    }
    property <string> tip: root.tooltip != "" ? root.tooltip : root.iconic ? root.label : "";
    // Once per visit of the pointer.
    property <bool> tip-shown;
    Timer {
        interval: 600ms;
        running: touch.has-hover && root.tip != "" && !root.tip-shown;
        triggered => {
            root.tip-shown = true;
            Tip.x = root.absolute-position.x + root.width / 2;
            Tip.y = root.absolute-position.y + root.height;
            Tip.text = root.tip;
        }
    }
    property <bool> hovered: touch.has-hover;
    changed hovered => {
        if (!self.hovered) {
            root.tip-shown = false;
            if (Tip.text == root.tip) {
                Tip.text = "";
            }
        }
    }
}

// The line between two panes, dragged to resize the pane before it.
export component Splitter inherits Rectangle {
    // The pane's width now, and the bounds it is kept within.
    in property <length> size;
    in property <length> minimum;
    in property <length> maximum;
    callback resized(length);
    // The drag ended: the width can be kept.
    callback released();
    width: 1px;
    horizontal-stretch: 0;
    background: Theme.divider;
    property <length> start-size;
    property <length> start-x;
    // Wider than the line, so it is easy to catch.
    touch := TouchArea {
        x: -3px;
        width: 7px;
        mouse-cursor: ew-resize;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.start-size = root.size;
                root.start-x = self.absolute-position.x + self.mouse-x;
            }
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                root.released();
            }
        }
        moved => {
            if (self.pressed) {
                root.resized(clamp(root.start-size + self.absolute-position.x + self.mouse-x - root.start-x, root.minimum, max(root.minimum, root.maximum)));
            }
        }
    }
    Rectangle {
        x: -1px;
        width: 3px;
        background: touch.pressed ? Theme.accent : touch.has-hover ? Theme.accent.with-alpha(0.5) : transparent;
    }
}

// A person: their picture, or their initials in a colour of their own.
export component Avatar inherits Rectangle {
    in property <string> initials;
    in property <length> size: 36px;
    // Which of Theme.person-colors; the accent when out of range.
    in property <int> hue: -1;
    in property <image> picture;
    property <color> tint: root.hue >= 0 && root.hue < Theme.person-colors.length ? Theme.person-colors[root.hue] : Theme.accent;
    width: size;
    height: size;
    border-radius: size / 2;
    background: root.picture.width > 0 ? transparent : tint.with-alpha(Theme.dark ? 0.24 : 0.16);
    if root.picture.width == 0: Text {
        text: root.initials;
        color: root.tint;
        font-size: root.size * 0.38;
        font-weight: 600;
    }
    if root.picture.width > 0: Image {
        width: root.size;
        height: root.size;
        source: root.picture;
        image-fit: cover;
    }
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.divider;
}

export component VDivider inherits Rectangle {
    width: 1px;
    background: Theme.divider;
}

// A labelled single-line field, styled to match the panes.
export component Field inherits Rectangle {
    in property <string> label;
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    in property <bool> read-only;
    in property <length> label-width: 64px;
    callback edited(string);
    callback accepted();
    height: 36px;
    HorizontalLayout {
        spacing: 8px;
        if root.label != "": Text {
            width: root.label-width;
            text: root.label;
            color: Theme.text-muted;
            vertical-alignment: center;
            font-size: Theme.font-size;
        }
        Rectangle {
            clip: true;
            input := TextInput {
                y: 0;
                width: 100%;
                height: 100%;
                vertical-alignment: center;
                color: Theme.text;
                font-size: Theme.font-size;
                read-only: root.read-only;
                single-line: true;
                selection-background-color: Theme.selected-strong;
                edited => { root.edited(self.text); }
                accepted => { root.accepted(); }
            }
            if input.text == "" && root.placeholder != "": Text {
                x: 0;
                text: root.placeholder;
                color: Theme.text-faint;
                font-size: Theme.font-size;
                vertical-alignment: center;
            }
        }
    }
    Divider {
        y: parent.height - 1px;
        background: input.has-focus ? Theme.accent : Theme.divider;
    }
    public function focus-input() {
        input.focus();
    }
}

// A search box with a magnifier and a clear button.
export component SearchBox inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder: "Search";
    callback edited(string);
    callback accepted(string);
    height: 32px;
    border-radius: Theme.radius;
    background: Theme.surface-alt;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.divider;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 4px;
        spacing: 6px;
        Icon {
            y: (parent.height - self.height) / 2;
            icon: "M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z";
            width: 16px;
            height: 16px;
        }
        Rectangle {
            input := TextInput {
                y: 0;
                width: 100%;
                height: 100%;
                vertical-alignment: center;
                color: Theme.text;
                font-size: Theme.font-size;
                single-line: true;
                edited => { root.edited(self.text); }
                accepted => { root.accepted(self.text); }
            }
            if input.text == "": Text {
                x: 0;
                text: root.placeholder;
                color: Theme.text-faint;
                font-size: Theme.font-size;
                vertical-alignment: center;
            }
        }
        if input.text != "": IconButton {
            y: (parent.height - self.height) / 2;
            icon: "M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z";
            size: 24px;
            icon-size: 14px;
            tooltip: "Clear";
            clicked => {
                input.text = "";
                root.edited("");
            }
        }
    }
    public function focus-input() {
        input.focus();
    }
}

// A dimmed backdrop with a centred card, for dialogs.
export component Overlay inherits Rectangle {
    in property <length> card-width: 480px;
    in property <length> card-height: 0px;
    callback dismissed();
    background: Theme.overlay;
    TouchArea {
        clicked => { root.dismissed(); }
    }
    Rectangle {
        width: min(root.card-width, root.width - 32px);
        height: root.card-height > 0 ? min(root.card-height, root.height - 32px) : self.preferred-height;
        background: Theme.surface;
        border-radius: 8px;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000040;
        // Clicks on the card stay on it.
        TouchArea { }
        @children
    }
}

// A drop-down list whose unavailable entries are shown greyed and can't be
// picked.
export component Picker inherits Rectangle {
    in property <[string]> model;
    // Per entry, whether it can be picked.
    in property <[bool]> available;
    in property <bool> enabled: true;
    in-out property <int> current-index;
    height: 40px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.divider;
    background: touch.has-hover && root.enabled ? Theme.hover : Theme.surface;
    opacity: root.enabled ? 1 : 0.5;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 6px;
        spacing: 6px;
        Text {
            text: root.model[root.current-index];
            color: root.available[root.current-index] ? Theme.text : Theme.text-faint;
            font-size: Theme.font-size;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Icon {
            y: (parent.height - self.height) / 2;
            icon: Icons.expand;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { popup.show(); }
    }
    // Stays open on a click on an unavailable entry.
    popup := PopupWindow {
        y: root.height + 2px;
        width: root.width;
        height: min(entries.preferred-height, 320px);
        close-policy: close-on-click-outside;
        Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.surface;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.divider;
            drop-shadow-blur: 8px;
            drop-shadow-color: #00000030;
            Flickable {
                content-height: entries.preferred-height;
                entries := VerticalLayout {
                    padding: 4px;
                    for label[index] in root.model: Rectangle {
                        height: 32px;
                        border-radius: Theme.radius;
                        background: index == root.current-index ? Theme.selected : entry.has-hover && entry.enabled ? Theme.hover : transparent;
                        Text {
                            x: 8px;
                            width: parent.width - 16px;
                            text: label;
                            color: root.available[index] ? Theme.text : Theme.text-faint;
                            font-size: Theme.font-size;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        entry := TouchArea {
                            enabled: root.available[index];
                            mouse-cursor: self.enabled ? pointer : default;
                            clicked => {
                                root.current-index = index;
                                popup.close();
                            }
                        }
                    }
                }
            }
        }
    }
}

// An entry of a MoreButton's menu.
export struct MenuEntry {
    id: string,
    icon: string,
    label: string,
}

// A button opening a menu of actions there is no room for.
export component MoreButton inherits Rectangle {
    in property <[MenuEntry]> entries;
    callback activated(string);
    width: 32px;
    height: 32px;
    IconButton {
        icon: Icons.more;
        tooltip: "More actions";
        clicked => { popup.show(); }
    }
    popup := PopupWindow {
        x: root.width - self.width;
        y: root.height + 4px;
        width: 240px;
        height: column.preferred-height;
        Rectangle {
            background: Theme.surface;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.divider;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000030;
            column := VerticalLayout {
                padding: 4px;
                for entry in root.entries: Rectangle {
                    height: 34px;
                    border-radius: Theme.radius;
                    background: entry-touch.has-hover ? Theme.hover : transparent;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 12px;
                        Icon {
                            y: (parent.height - self.height) / 2;
                            icon: entry.icon;
                        }
                        Text {
                            text: entry.label;
                            color: Theme.text;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    entry-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.activated(entry.id); }
                    }
                }
            }
        }
    }
}
