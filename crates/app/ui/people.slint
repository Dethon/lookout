// The people page: contacts across accounts, a card, and the editor.

import { ListView, TextEdit, ComboBox } from "std-widgets.slint";
import { Theme, Icons } from "theme.slint";
import { Icon, IconButton, ToolButton, Avatar, Divider, Field, SearchBox, Overlay, Splitter } from "widgets.slint";
import { Panes } from "panes.slint";
import { ContactRow, ContactView, ContactEditor } from "types.slint";

// A titled group of lines on a contact's card.
component Section inherits VerticalLayout {
    in property <string> title;
    spacing: 4px;
    max-width: 640px;
    Text {
        text: root.title;
        color: Theme.text-muted;
        font-size: Theme.small;
        font-weight: 600;
    }
    Divider { }
    Rectangle { height: 4px; }
    @children
}

export component PeopleView inherits Rectangle {
    in property <[ContactRow]> contacts;
    in property <int> selected: -1;
    in property <ContactView> contact;
    in-out property <string> filter;
    callback filter-edited(string);
    callback select(int);
    callback new-contact();
    callback edit-contact();
    callback delete-contact();
    callback email(string);
    callback open-message(string, string, string);
    background: Theme.surface;

    HorizontalLayout {
        Rectangle {
            width: min(Panes.people, root.width - 360px);
            background: Theme.surface;
            VerticalLayout {
                HorizontalLayout {
                    padding: 8px;
                    spacing: 6px;
                    SearchBox {
                        text <=> root.filter;
                        placeholder: "Search people";
                        edited(text) => { root.filter-edited(text); }
                    }
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: Icons.add;
                        tooltip: "New contact";
                        tint: Theme.accent;
                        clicked => { root.new-contact(); }
                    }
                }
                Divider { }
                ListView {
                    for contact[index] in root.contacts: Rectangle {
                        height: 56px;
                        background: index == root.selected ? Theme.selected : touch.has-hover ? Theme.hover : transparent;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 18px;
                            spacing: 10px;
                            Avatar {
                                y: (parent.height - self.height) / 2;
                                initials: contact.initials;
                                hue: contact.hue;
                                picture: contact.picture;
                            }
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: contact.name;
                                    color: Theme.text;
                                    overflow: elide;
                                }
                                if contact.detail != "": Text {
                                    text: contact.detail;
                                    color: Theme.text-muted;
                                    font-size: Theme.small;
                                    overflow: elide;
                                }
                            }
                        }
                        touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.select(index); }
                        }
                    }
                }
            }
        }
        Splitter {
            size: min(Panes.people, root.width - 360px);
            minimum: 240px;
            maximum: min(560px, root.width - 360px);
            resized(width) => { Panes.people = width; }
            released => { Panes.changed(); }
        }
        Rectangle {
            horizontal-stretch: 1;
            background: Theme.surface;
            if !root.contact.shown: Text {
                text: "Select a person to see their details";
                color: Theme.text-faint;
            }
            if root.contact.shown: Flickable {
                content-height: card.preferred-height;
                card := VerticalLayout {
                    width: parent.width;
                    padding: 28px;
                    padding-top: 24px;
                    spacing: 20px;
                    alignment: start;
                    // Who, and what can be done.
                    HorizontalLayout {
                        spacing: 20px;
                        Avatar {
                            y: 0;
                            initials: root.contact.initials;
                            hue: root.contact.hue;
                            picture: root.contact.picture;
                            size: 88px;
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 4px;
                            Text {
                                text: root.contact.name;
                                font-size: 24px;
                                font-weight: 600;
                                color: Theme.text;
                                overflow: elide;
                            }
                            if root.contact.title != "": Text {
                                text: root.contact.title;
                                color: Theme.text-muted;
                                overflow: elide;
                            }
                            HorizontalLayout {
                                padding-top: 8px;
                                spacing: 6px;
                                alignment: start;
                                if root.contact.emails.length > 0: ToolButton {
                                    icon: Icons.send;
                                    label: "Email";
                                    primary: true;
                                    clicked => { root.email(root.contact.emails[0]); }
                                }
                                ToolButton {
                                    icon: Icons.edit;
                                    label: "Edit";
                                    clicked => { root.edit-contact(); }
                                }
                                ToolButton {
                                    icon: Icons.delete;
                                    label: "Delete";
                                    tint: Theme.danger;
                                    clicked => { root.delete-contact(); }
                                }
                            }
                        }
                    }
                    if root.contact.fields.length > 0 || root.contact.notes != "": Section {
                        title: "Contact information";
                        for field in root.contact.fields: HorizontalLayout {
                            spacing: 14px;
                            min-height: 40px;
                            Icon {
                                y: (parent.height - self.height) / 2;
                                icon: field.icon;
                            }
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: field.label;
                                    color: Theme.text-muted;
                                    font-size: Theme.small;
                                }
                                Text {
                                    text: field.value;
                                    color: field.email ? Theme.link : Theme.text;
                                    overflow: elide;
                                    TouchArea {
                                        enabled: field.email;
                                        mouse-cursor: field.email ? pointer : default;
                                        clicked => { root.email(field.value); }
                                    }
                                }
                            }
                        }
                        if root.contact.notes != "": HorizontalLayout {
                            spacing: 14px;
                            Icon {
                                y: 2px;
                                icon: Icons.notes;
                            }
                            VerticalLayout {
                                Text {
                                    text: "Notes";
                                    color: Theme.text-muted;
                                    font-size: Theme.small;
                                }
                                Text {
                                    text: root.contact.notes;
                                    color: Theme.text;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                    if root.contact.recent.length > 0: Section {
                        title: "Recent messages";
                        for message in root.contact.recent: Rectangle {
                            height: 52px;
                            border-radius: Theme.radius;
                            background: recent-touch.has-hover ? Theme.hover : transparent;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 8px;
                                spacing: 12px;
                                Icon {
                                    y: (parent.height - self.height) / 2;
                                    icon: message.incoming ? Icons.inbox : Icons.send;
                                    color: Theme.text-faint;
                                    width: 16px;
                                    height: 16px;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text {
                                            text: message.subject == "" ? "(no subject)" : message.subject;
                                            color: Theme.text;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                        Text {
                                            text: message.date;
                                            color: Theme.text-muted;
                                            font-size: Theme.small;
                                        }
                                    }
                                    Text {
                                        text: message.preview;
                                        color: Theme.text-muted;
                                        font-size: Theme.small;
                                        overflow: elide;
                                    }
                                }
                            }
                            recent-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.open-message(message.account, message.folder, message.id); }
                            }
                        }
                    }
                }
            }
        }
    }
}

export component ContactEditorDialog inherits Overlay {
    in-out property <ContactEditor> editor;
    in property <[string]> account-labels;
    callback save(ContactEditor);
    callback cancel();
    card-width: 520px;
    dismissed => { root.cancel(); }

    VerticalLayout {
        padding: 20px;
        spacing: 4px;
        HorizontalLayout {
            Text {
                text: root.editor.id == "" ? "New contact" : "Edit contact";
                font-size: 18px;
                font-weight: 600;
                color: Theme.text;
                horizontal-stretch: 1;
            }
            IconButton {
                icon: Icons.close;
                tooltip: "Close";
                clicked => { root.cancel(); }
            }
        }
        if root.editor.id == "" && root.account-labels.length > 1: HorizontalLayout {
            height: 40px;
            spacing: 8px;
            Text {
                width: 96px;
                text: "Account";
                color: Theme.text-muted;
                vertical-alignment: center;
            }
            ComboBox {
                y: (parent.height - self.height) / 2;
                model: root.account-labels;
                current-index <=> root.editor.account-index;
            }
        }
        Field { label: "First name"; label-width: 96px; text <=> root.editor.given-name; }
        Field { label: "Last name"; label-width: 96px; text <=> root.editor.surname; }
        Field { label: "Display as"; label-width: 96px; text <=> root.editor.display-name; placeholder: "First and last name"; }
        Field { label: "Email"; label-width: 96px; text <=> root.editor.emails; placeholder: "Addresses, separated by ;"; }
        Field { label: "Mobile"; label-width: 96px; text <=> root.editor.mobile; }
        Field { label: "Work phone"; label-width: 96px; text <=> root.editor.business; }
        Field { label: "Home phone"; label-width: 96px; text <=> root.editor.home; }
        Field { label: "Company"; label-width: 96px; text <=> root.editor.company; }
        Field { label: "Job title"; label-width: 96px; text <=> root.editor.job-title; }
        TextEdit {
            height: 80px;
            text <=> root.editor.notes;
            wrap: word-wrap;
            placeholder-text: "Notes";
        }
        HorizontalLayout {
            padding-top: 8px;
            alignment: end;
            spacing: 8px;
            ToolButton {
                label: "Cancel";
                clicked => { root.cancel(); }
            }
            ToolButton {
                label: root.editor.saving ? "Saving…" : "Save";
                primary: true;
                enabled: !root.editor.saving;
                clicked => { root.save(root.editor); }
            }
        }
    }
}
