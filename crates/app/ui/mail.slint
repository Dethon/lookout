// The mail page: folders, the message list, and the reading pane or composer.

import { ListView, ScrollView, TextEdit, ComboBox, CheckBox, Spinner } from "std-widgets.slint";
import { Theme, Icons } from "theme.slint";
import { Panes } from "panes.slint";
import { Icon, IconButton, ToolButton, Avatar, Divider, VDivider, Field, SearchBox, Tip, MoreButton, MenuEntry } from "widgets.slint";
import { FolderRow, MessageRow, BodyBlock, AttachmentRow, Reader, Compose, FormatResult, Suggestion } from "types.slint";

export component FolderPane inherits Rectangle {
    in property <[FolderRow]> folders;
    in property <string> selected-account;
    in property <string> selected-folder;
    callback new-message();
    callback folder-clicked(string, string);
    callback add-account();
    // Messages dragged from the list were dropped on a folder.
    callback dropped-on(string, string);
    callback toggle-expanded(string, string);
    callback toggle-favourite(string, string);
    // Puts the pane away.
    callback collapse();
    background: Theme.background;

    VerticalLayout {
        padding: 8px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 4px;
            ToolButton {
                horizontal-stretch: 1;
                icon: Icons.edit;
                label: "New mail";
                primary: true;
                clicked => { root.new-message(); }
            }
            IconButton {
                icon: Icons.menu-open;
                tooltip: "Hide folders (Ctrl+B)";
                clicked => { root.collapse(); }
            }
        }
        list := ListView {
            // The scroll bar is drawn over the list; rows stop short of it.
            property <length> gutter: self.content-height > self.visible-height ? 14px : 0px;
            for folder in root.folders: Rectangle {
                height: folder.divider ? 13px : folder.header ? 34px : 32px;
                if folder.divider: Rectangle {
                    x: 8px;
                    width: parent.width - list.gutter - 16px;
                    height: 1px;
                    background: Theme.divider;
                }
                if !folder.divider: Rectangle {
                    x: 0;
                    width: parent.width - list.gutter;
                    border-radius: Theme.radius;
                    property <bool> selected: !folder.header && folder.account == root.selected-account && folder.id == root.selected-folder;
                    background: drop.has-drag ? Theme.selected-strong : selected ? Theme.selected : touch.has-hover && !folder.header ? Theme.hover : transparent;
                    HorizontalLayout {
                        padding-left: 2px + folder.depth * 14px;
                        padding-right: 8px;
                        spacing: 4px;
                        // Shows or hides the subfolders.
                        Rectangle {
                            width: 18px;
                            if folder.expandable: Icon {
                                icon: folder.expanded ? "M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z" : Icons.right;
                                width: 16px;
                                height: 16px;
                                color: Theme.text-faint;
                            }
                            TouchArea {
                                enabled: folder.expandable;
                                mouse-cursor: pointer;
                                clicked => { root.toggle-expanded(folder.account, folder.id); }
                            }
                        }
                        if !folder.header: Icon {
                            y: (parent.height - self.height) / 2;
                            icon: folder.icon;
                            width: 16px;
                            height: 16px;
                            color: selected ? Theme.accent : Theme.text-muted;
                        }
                        Text {
                            text: folder.name;
                            color: folder.header ? Theme.text-muted : Theme.text;
                            font-size: folder.header ? Theme.small : Theme.font-size;
                            font-weight: folder.header || folder.unread > 0 ? 600 : 400;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        if folder.unread > 0: Text {
                            text: folder.unread;
                            color: Theme.accent;
                            font-size: Theme.small;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                    touch := TouchArea {
                        x: 20px + folder.depth * 14px;
                        width: parent.width - self.x;
                        enabled: !folder.header || folder.expandable;
                        mouse-cursor: pointer;
                        clicked => {
                            if (folder.header) {
                                root.toggle-expanded(folder.account, folder.id);
                            } else {
                                root.folder-clicked(folder.account, folder.id);
                            }
                        }
                    }
                    if !folder.header: ContextMenuArea {
                        Menu {
                            MenuItem {
                                title: folder.favourite ? "Remove from Favourites" : "Add to Favourites";
                                activated => { root.toggle-favourite(folder.account, folder.id); }
                            }
                        }
                    }
                    drop := DropArea {
                        enabled: !folder.header;
                        can-drop(event) => { return DragAction.move; }
                        dropped(event) => {
                            root.dropped-on(folder.account, folder.id);
                            return DragAction.move;
                        }
                    }
                }
            }
        }
        ToolButton {
            icon: Icons.add;
            label: "Add account";
            tint: Theme.text-muted;
            clicked => { root.add-account(); }
        }
    }
}

// The folder pane put away: a strip with the favourite or standard folders
// as icons, their unread counts as badges.
export component FolderStrip inherits Rectangle {
    in property <[FolderRow]> folders;
    in property <string> selected-account;
    in property <string> selected-folder;
    callback expand();
    callback new-message();
    callback folder-clicked(string, string);
    callback dropped-on(string, string);
    width: 48px;
    background: Theme.background;
    VerticalLayout {
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 4px;
        alignment: start;
        IconButton {
            x: (parent.width - self.width) / 2;
            icon: Icons.menu;
            tooltip: "Show folders (Ctrl+B)";
            size: 36px;
            clicked => { root.expand(); }
        }
        IconButton {
            x: (parent.width - self.width) / 2;
            icon: Icons.edit;
            tooltip: "New mail (Ctrl+N)";
            size: 36px;
            tint: Theme.on-accent;
            background: self.hovered ? Theme.accent-hover : Theme.accent;
            clicked => { root.new-message(); }
        }
        Rectangle { height: 6px; }
        for folder in root.folders: Rectangle {
            property <bool> selected: folder.account == root.selected-account && folder.id == root.selected-folder;
            x: (parent.width - self.width) / 2;
            width: 36px;
            height: 36px;
            border-radius: Theme.radius;
            background: drop.has-drag ? Theme.selected-strong : selected ? Theme.selected : transparent;
            IconButton {
                icon: folder.icon;
                tooltip: folder.unread > 0 ? folder.name + " (" + folder.unread + ")" : folder.name;
                size: 36px;
                tint: selected ? Theme.accent : Theme.text-muted;
                clicked => { root.folder-clicked(folder.account, folder.id); }
            }
            if folder.unread > 0: Rectangle {
                x: parent.width - self.width + 3px;
                y: 1px;
                height: 15px;
                width: max(15px, badge.preferred-width + 8px);
                border-radius: 7.5px;
                background: Theme.accent;
                border-width: 1.5px;
                border-color: Theme.background;
                badge := Text {
                    text: folder.unread > 99 ? "99+" : folder.unread;
                    color: Theme.on-accent;
                    font-size: 9px;
                    font-weight: 700;
                }
            }
            drop := DropArea {
                can-drop(event) => { return DragAction.move; }
                dropped(event) => {
                    root.dropped-on(folder.account, folder.id);
                    return DragAction.move;
                }
            }
        }
    }
}

export component MessageList inherits Rectangle {
    in property <[MessageRow]> messages;
    in property <string> title;
    in property <int> selected: -1;
    in property <bool> searching;
    in property <bool> unread-only;
    in property <bool> busy;
    in property <string> empty-text: "Nothing here";
    // Each row shows its sender's picture or initials.
    in property <bool> avatars: true;
    // Messages picked with Ctrl or Shift, or the check boxes.
    in property <int> selection-count;
    in-out property <string> search-text;
    // The row, and whether Ctrl and Shift were held.
    callback select(int, bool, bool);
    callback drag-started(int);
    // A press and release without dragging.
    callback row-clicked(int);
    in property <data-transfer> drag-payload;
    callback search(string);
    callback search-server();
    callback toggle-unread-only();
    callback toggle-flag(int);
    callback delete-at(int);
    callback toggle-read(int);
    callback archive-at(int);
    callback move-at(int);
    callback scrolled-to-end();
    background: Theme.surface;

    in property <int> focus-request;
    changed focus-request => { search.focus-input(); }

    VerticalLayout {
        HorizontalLayout {
            padding: 8px;
            search := SearchBox {
                text <=> root.search-text;
                placeholder: "Search mail";
                edited(text) => { root.search(text); }
                accepted(text) => { root.search(text); }
            }
        }
        HorizontalLayout {
            padding-left: 14px;
            padding-right: 8px;
            height: 36px;
            spacing: 6px;
            Text {
                text: root.title;
                font-size: 16px;
                font-weight: 600;
                color: Theme.text;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            if root.busy: Spinner {
                width: 16px;
                height: 16px;
                y: (parent.height - self.height) / 2;
                indeterminate: true;
            }
            if root.searching: ToolButton {
                y: (parent.height - self.height) / 2;
                label: "Search server";
                icon: Icons.search;
                tint: Theme.accent;
                clicked => { root.search-server(); }
            }
            if !root.searching: ToolButton {
                y: (parent.height - self.height) / 2;
                label: root.unread-only ? "Unread" : "All";
                tint: root.unread-only ? Theme.accent : Theme.text-muted;
                clicked => { root.toggle-unread-only(); }
            }
        }
        Divider { }
        if root.messages.length == 0 && !root.busy: Text {
            text: root.empty-text;
            color: Theme.text-faint;
            horizontal-alignment: center;
            vertical-alignment: top;
            height: 80px;
        }
        list := ListView {
            vertical-stretch: 1;
            changed content-y => {
                if (-self.content-y + self.visible-height >= self.content-height - 200px) {
                    root.scrolled-to-end();
                }
            }
            for message[index] in root.messages: Rectangle {
                property <length> heading: message.group != "" ? 30px : 0px;
                height: heading + Theme.row-height;
                if message.group != "": Rectangle {
                    y: 0;
                    height: 30px;
                    background: Theme.surface-alt;
                    Text {
                        x: 14px;
                        text: message.group;
                        color: Theme.text-muted;
                        font-size: Theme.small;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                y: heading;
                height: Theme.row-height;
                property <bool> is-selected: index == root.selected || message.selected;
                background: drag.dragging ? Theme.selected-strong : is-selected ? Theme.selected : touch.has-hover ? Theme.hover : transparent;
                // Unread bar.
                Rectangle {
                    x: 0;
                    width: 3px;
                    height: parent.height - 12px;
                    y: 6px;
                    background: message.unread ? Theme.accent : transparent;
                }
                // Dragged onto a folder, the selection moves there.
                drag := DragArea {
                    allow-move: true;
                    data: root.drag-payload;
                    changed dragging => {
                        if (self.dragging) {
                            root.drag-started(index);
                        }
                    }
                    touch := TouchArea {
                        mouse-cursor: pointer;
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                root.select(index, event.modifiers.control, event.modifiers.shift);
                            }
                        }
                        clicked => { root.row-clicked(index); }
                        // Over a row, or while several are picked, a check
                        // box takes the avatar's place to pick more.
                        property <bool> checking: root.avatars && (touch.has-hover || root.selection-count > 1);
                        if root.avatars && !checking: Avatar {
                            x: 14px;
                            y: 10px;
                            size: 32px;
                            initials: message.initials;
                            hue: message.hue;
                            picture: message.picture;
                        }
                        if checking: Rectangle {
                            property <bool> checked: message.selected && root.selection-count > 1;
                            x: 14px;
                            y: 10px;
                            width: 32px;
                            height: 32px;
                            Rectangle {
                                width: 20px;
                                height: 20px;
                                border-radius: 10px;
                                border-width: checked ? 0px : 1.5px;
                                border-color: check-touch.has-hover ? Theme.accent : Theme.text-muted;
                                background: checked ? Theme.accent : check-touch.has-hover ? Theme.hover : Theme.surface;
                                if checked: Icon {
                                    icon: Icons.check;
                                    color: Theme.on-accent;
                                    width: 14px;
                                    height: 14px;
                                }
                            }
                            check-touch := TouchArea {
                                mouse-cursor: pointer;
                                // As a Ctrl+click.
                                clicked => { root.select(index, true, false); }
                            }
                        }
                        // Inside, so the row keeps its hover over the quick actions.
                        VerticalLayout {
                            padding-left: root.avatars ? 58px : 14px;
                            padding-right: 16px;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            spacing: 2px;
                            HorizontalLayout {
                                // Fixed, so the quick actions don't push the
                                // lines below down as they show.
                                height: 18px;
                                spacing: 6px;
                                if message.draft: Text {
                                    text: "[Draft]";
                                    color: Theme.danger;
                                    font-size: Theme.font-size;
                                }
                                Text {
                                    text: message.sender;
                                    color: Theme.text;
                                    font-size: Theme.font-size;
                                    font-weight: message.unread ? 700 : 400;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                // Quick actions on hover, the date otherwise.
                                if touch.has-hover: HorizontalLayout {
                                    y: -2px;
                                    height: 22px;
                                    spacing: 0px;
                                    IconButton {
                                        icon: message.unread ? Icons.mail-open : Icons.mail;
                                        tooltip: message.unread ? "Mark as read" : "Mark as unread";
                                        size: 22px;
                                        icon-size: 15px;
                                        clicked => { root.toggle-read(index); }
                                    }
                                    IconButton {
                                        icon: Icons.archive;
                                        tooltip: "Archive";
                                        size: 22px;
                                        icon-size: 15px;
                                        clicked => { root.archive-at(index); }
                                    }
                                    IconButton {
                                        icon: Icons.delete;
                                        tooltip: "Delete (Del)";
                                        size: 22px;
                                        icon-size: 15px;
                                        clicked => { root.delete-at(index); }
                                    }
                                }
                                if !touch.has-hover: Text {
                                    text: message.date;
                                    color: message.unread ? Theme.accent : Theme.text-muted;
                                    font-size: Theme.small;
                                    vertical-alignment: center;
                                }
                            }
                            HorizontalLayout {
                                spacing: 4px;
                                if message.important: Icon {
                                    icon: Icons.important;
                                    color: Theme.danger;
                                    width: 12px;
                                    height: 14px;
                                }
                                Text {
                                    text: message.subject == "" ? "(no subject)" : message.subject;
                                    color: message.unread ? Theme.accent : Theme.text;
                                    font-size: Theme.font-size;
                                    font-weight: message.unread ? 600 : 400;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                if message.attachment: Icon {
                                    icon: Icons.attach;
                                    width: 14px;
                                    height: 14px;
                                }
                                IconButton {
                                    icon: message.flagged ? Icons.flag : message.completed ? Icons.check : Icons.flag-outline;
                                    tooltip: message.flagged ? "Clear flag" : "Flag";
                                    tint: message.flagged ? Theme.flag : Theme.text-faint;
                                    size: 18px;
                                    icon-size: 14px;
                                    opacity: message.flagged || message.completed || touch.has-hover ? 1 : 0;
                                    clicked => { root.toggle-flag(index); }
                                }
                            }
                            Text {
                                text: message.preview;
                                color: Theme.text-muted;
                                font-size: Theme.small + 1px;
                                overflow: elide;
                            }
                        }
                    }
                }
                ContextMenuArea {
                    Menu {
                        MenuItem {
                            title: message.unread ? "Mark as read" : "Mark as unread";
                            activated => { root.toggle-read(index); }
                        }
                        MenuItem {
                            title: message.flagged ? "Clear flag" : "Flag";
                            activated => { root.toggle-flag(index); }
                        }
                        MenuItem {
                            title: "Archive";
                            activated => { root.archive-at(index); }
                        }
                        MenuItem {
                            title: "Move to…";
                            activated => { root.move-at(index); }
                        }
                        MenuItem {
                            title: "Delete";
                            activated => { root.delete-at(index); }
                        }
                    }
                }
                Divider {
                    y: parent.height - 1px;
                    x: root.avatars ? 58px : 14px;
                    width: parent.width - self.x;
                }
                }
            }
        }
    }
}

// The message as sent: Blitz paints what is in view into `picture`.
export component PageView inherits Rectangle {
    in property <image> picture;
    in property <length> page-width;
    in property <length> page-height;
    // The size in view, and how far the page is scrolled.
    callback view(length, length, length, length);
    callback clicked(length, length);
    pure callback over-link(length, length) -> bool;
    // Messages bring their own colours, made for a white page.
    background: white;
    function report() {
        root.view(scroll.visible-width, scroll.visible-height, -scroll.content-x, -scroll.content-y);
    }
    init => { root.report(); }
    scroll := ScrollView {
        width: 100%;
        height: 100%;
        content-width: max(root.page-width, self.visible-width);
        content-height: max(root.page-height, self.visible-height);
        changed visible-width => { root.report(); }
        changed visible-height => { root.report(); }
        changed content-x => { root.report(); }
        changed content-y => { root.report(); }
        Image {
            x: -scroll.content-x;
            y: -scroll.content-y;
            width: scroll.visible-width;
            height: scroll.visible-height;
            source: root.picture;
            image-fit: fill;
        }
        TouchArea {
            width: scroll.content-width;
            height: scroll.content-height;
            mouse-cursor: self.has-hover && root.over-link(self.mouse-x, self.mouse-y) ? pointer : default;
            clicked => { root.clicked(self.pressed-x, self.pressed-y); }
        }
    }
}

// The message body: paragraphs, headings, rules and pictures.
export component BodyView inherits Rectangle {
    in property <[BodyBlock]> blocks;
    callback link-clicked(string);
    list := ListView {
        width: 100%;
        height: 100%;
        for block in root.blocks: Rectangle {
            property <length> left: 20px + block.indent * 18px + block.quote * 14px;
            height: content.preferred-height;
            content := VerticalLayout {
                padding-left: left;
                padding-right: 24px;
                padding-top: block.kind == 1 ? 10px : block.kind == 2 ? 8px : 3px;
                padding-bottom: block.kind == 2 ? 8px : 5px;
                if block.kind == 0 || block.kind == 1: StyledText {
                    text: block.text;
                    default-color: Theme.text;
                    link-color: Theme.link;
                    default-font-family: block.mono ? "Consolas" : "";
                    default-font-size: block.kind == 1 ? (block.level <= 1 ? 22px : block.level == 2 ? 19px : 16px) : Theme.font-size;
                    link-clicked(link) => { root.link-clicked(link); }
                }
                if block.kind == 2: Divider { }
                if block.kind == 3: Rectangle {
                    // The row shrinks as a whole when the pane is narrower.
                    property <float> scale: min(1, (root.width - left - 44px) / max(1px, block.row-width));
                    height: block.row-height * scale;
                    for picture in block.pictures: Rectangle {
                        x: picture.x * scale;
                        y: 0;
                        width: picture.width * scale;
                        height: picture.height * scale;
                        if picture.loaded: Image {
                            width: 100%;
                            height: 100%;
                            source: picture.image;
                            image-fit: contain;
                        }
                        if !picture.loaded: Rectangle {
                            border-width: 1px;
                            border-color: Theme.divider;
                            background: Theme.surface-alt;
                            clip: true;
                            HorizontalLayout {
                                padding: 5px;
                                spacing: 5px;
                                alignment: start;
                                Icon {
                                    icon: Icons.image;
                                    color: Theme.text-faint;
                                    width: 16px;
                                    height: 16px;
                                }
                                Text {
                                    text: picture.alt == "" ? "Picture" : picture.alt;
                                    color: picture.link != "" ? Theme.link : Theme.text-faint;
                                    font-size: Theme.small;
                                    overflow: elide;
                                    vertical-alignment: top;
                                }
                            }
                        }
                        TouchArea {
                            enabled: picture.link != "";
                            mouse-cursor: picture.link != "" ? pointer : default;
                            clicked => { root.link-clicked(picture.link); }
                        }
                    }
                }
            }
            // A bar for each level of quoting.
            for level in block.quote: Rectangle {
                x: 20px + block.indent * 18px + level * 14px + 2px;
                width: 3px;
                height: parent.height;
                background: Theme.quote-bar;
            }
        }
    }
}

export component ReadingPane inherits Rectangle {
    in property <Reader> reader;
    in property <[BodyBlock]> blocks;
    in property <[AttachmentRow]> attachments;
    in property <bool> select-text;
    // Messages picked with Ctrl or Shift; past one, they are acted on together.
    in property <int> selection-count;
    callback bulk(string);
    callback clear-selection();
    callback reply();
    callback reply-all();
    callback forward();
    callback delete();
    callback archive();
    callback move();
    callback toggle-flag();
    callback toggle-read();
    callback show-images();
    // The body as sent instead of simplified: drawn by Blitz into a
    // picture (`page`), or in WebView2 (`webview`).
    in property <bool> original;
    callback toggle-original();
    in property <bool> page;
    in property <image> page-picture;
    in property <length> page-width;
    in property <length> page-height;
    callback page-view(length, length, length, length);
    callback page-clicked(length, length);
    pure callback page-over-link(length, length) -> bool;
    in property <bool> webview;
    // Where the WebView2 panel goes, in window coordinates.
    callback original-area(length, length, length, length);
    callback toggle-select-text();
    callback open-attachment(string);
    callback save-attachment(string);
    callback link-clicked(string);
    callback edit-draft();
    // From the sender's card.
    callback email-sender();
    callback add-sender();
    callback show-sender();
    background: Theme.surface;

    if root.selection-count > 1: VerticalLayout {
        alignment: center;
        spacing: 14px;
        Icon {
            x: (parent.width - self.width) / 2;
            icon: Icons.mail;
            color: Theme.accent;
            width: 48px;
            height: 48px;
        }
        Text {
            text: root.selection-count + " messages selected";
            font-size: 20px;
            font-weight: 600;
            color: Theme.text;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            alignment: center;
            spacing: 4px;
            ToolButton { icon: Icons.mail-open; label: "Mark read"; clicked => { root.bulk("read"); } }
            ToolButton { icon: Icons.mail; label: "Mark unread"; clicked => { root.bulk("unread"); } }
            ToolButton { icon: Icons.flag-outline; label: "Flag"; clicked => { root.bulk("flag"); } }
            ToolButton { icon: Icons.archive; label: "Archive"; clicked => { root.bulk("archive"); } }
            ToolButton { icon: Icons.move; label: "Move"; clicked => { root.bulk("move"); } }
            ToolButton { icon: Icons.delete; label: "Delete"; tint: Theme.danger; clicked => { root.bulk("delete"); } }
        }
        HorizontalLayout {
            alignment: center;
            ToolButton {
                label: "Clear selection";
                tint: Theme.text-muted;
                clicked => { root.clear-selection(); }
            }
        }
    }

    if !root.reader.open && root.selection-count <= 1: VerticalLayout {
        alignment: center;
        spacing: 8px;
        Icon {
            x: (parent.width - self.width) / 2;
            icon: Icons.mail-open;
            color: Theme.text-faint;
            width: 48px;
            height: 48px;
        }
        Text {
            text: "Select a message to read it";
            color: Theme.text-faint;
            horizontal-alignment: center;
        }
    }

    // As the pane narrows, the toolbar's labels go, then the least used
    // actions move to a menu: 3 everything, 2 labels for answering only,
    // 1 icons only, 0 a menu besides.
    property <length> draft-room: root.reader.draft ? 100px : 0px;
    property <int> tier: root.width >= 700px + draft-room ? 3 : root.width >= 560px + draft-room ? 2 : root.width >= 420px ? 1 : 0;
    property <bool> compact: root.tier < 3;

    // Placed, so the toolbar that fits the width doesn't decide it.
    if root.reader.open && root.selection-count <= 1: VerticalLayout {
        width: parent.width;
        height: parent.height;
        // Toolbar.
        HorizontalLayout {
            padding: 6px;
            spacing: 2px;
            height: 44px;
            if root.reader.draft: ToolButton {
                icon: Icons.edit;
                label: "Edit draft";
                tint: Theme.accent;
                compact: root.compact;
                clicked => { root.edit-draft(); }
            }
            ToolButton {
                icon: Icons.reply;
                label: "Reply";
                tooltip: root.tier < 2 ? "Reply (Ctrl+R)" : "";
                compact: root.tier < 2;
                clicked => { root.reply(); }
            }
            ToolButton {
                icon: Icons.reply-all;
                label: "Reply all";
                tooltip: root.tier < 2 ? "Reply all (Ctrl+Shift+R)" : "";
                compact: root.tier < 2;
                clicked => { root.reply-all(); }
            }
            ToolButton {
                icon: Icons.forward;
                label: "Forward";
                tooltip: root.tier < 2 ? "Forward (Ctrl+F)" : "";
                compact: root.tier < 2;
                clicked => { root.forward(); }
            }
            // The message as sent, or simplified to suit the theme.
            ToolButton {
                icon: Icons.open-external;
                label: "Original";
                tooltip: root.original ? "Showing the message as sent; click for the simplified view" : "Show the message as sent";
                tint: root.original ? Theme.accent : Theme.text;
                active: root.original;
                compact: root.compact;
                clicked => { root.toggle-original(); }
            }
            Rectangle { horizontal-stretch: 1; }
            IconButton {
                icon: Icons.archive;
                tooltip: "Archive";
                clicked => { root.archive(); }
            }
            if root.tier > 0: IconButton {
                icon: Icons.move;
                tooltip: "Move to folder";
                clicked => { root.move(); }
            }
            IconButton {
                icon: Icons.delete;
                tooltip: "Delete (Del)";
                clicked => { root.delete(); }
            }
            IconButton {
                icon: root.reader.flagged ? Icons.flag : Icons.flag-outline;
                tooltip: root.reader.flagged ? "Clear flag" : "Flag";
                tint: root.reader.flagged ? Theme.flag : Theme.text-muted;
                clicked => { root.toggle-flag(); }
            }
            if root.tier > 0: IconButton {
                icon: root.reader.unread ? Icons.mail-open : Icons.mail;
                tooltip: root.reader.unread ? "Mark as read (Ctrl+Q)" : "Mark as unread (Ctrl+U)";
                clicked => { root.toggle-read(); }
            }
            if root.tier > 0: IconButton {
                icon: Icons.select-text;
                tooltip: "Select text to copy";
                active: root.select-text;
                clicked => { root.toggle-select-text(); }
            }
            if root.tier > 0: IconButton {
                icon: Panes.reading-only ? Icons.exit-full-view : Icons.full-view;
                tooltip: Panes.reading-only ? "Show folders and messages (Esc)" : "Read in full window";
                active: Panes.reading-only;
                clicked => { Panes.reading-only = !Panes.reading-only; }
            }
            if root.tier == 0: MoreButton {
                entries: [
                    { id: "move", icon: Icons.move, label: "Move to folder" },
                    { id: "read", icon: root.reader.unread ? Icons.mail-open : Icons.mail, label: root.reader.unread ? "Mark as read" : "Mark as unread" },
                    { id: "select", icon: Icons.select-text, label: root.select-text ? "Stop selecting text" : "Select text to copy" },
                    { id: "full", icon: Icons.full-view, label: Panes.reading-only ? "Show folders and messages" : "Read in full window" },
                ];
                activated(id) => {
                    if (id == "move") { root.move(); }
                    if (id == "read") { root.toggle-read(); }
                    if (id == "select") { root.toggle-select-text(); }
                    if (id == "full") { Panes.reading-only = !Panes.reading-only; }
                }
            }
        }
        Divider { }
        // Header.
        VerticalLayout {
            vertical-stretch: 0;
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 14px;
            padding-bottom: 10px;
            spacing: 10px;
            Text {
                text: root.reader.subject == "" ? "(no subject)" : root.reader.subject;
                font-size: 20px;
                font-weight: 600;
                color: Theme.text;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 12px;
                sender-avatar := Avatar {
                    initials: root.reader.initials;
                    hue: root.reader.hue;
                    picture: root.reader.picture;
                    size: 40px;
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { sender-card.show(); }
                    }
                    // Who sent it, and what can be done with them.
                    sender-card := PopupWindow {
                        x: 0;
                        y: parent.height + 6px;
                        width: min(340px, root.width - 40px);
                        height: card-content.preferred-height;
                        Rectangle {
                            background: Theme.surface;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.divider;
                            drop-shadow-blur: 16px;
                            drop-shadow-offset-y: 4px;
                            drop-shadow-color: #00000030;
                            card-content := VerticalLayout {
                                padding: 16px;
                                spacing: 14px;
                                HorizontalLayout {
                                    spacing: 12px;
                                    Avatar {
                                        initials: root.reader.initials;
                                        hue: root.reader.hue;
                                        picture: root.reader.picture;
                                        size: 56px;
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        Text {
                                            text: root.reader.sender;
                                            font-size: 16px;
                                            font-weight: 600;
                                            color: Theme.text;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: root.reader.sender-address;
                                            color: Theme.text-muted;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: root.reader.contact ? "In your contacts" : "Not in your contacts";
                                            color: Theme.text-faint;
                                            font-size: Theme.small;
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;
                                    ToolButton {
                                        icon: Icons.send;
                                        label: "Email";
                                        primary: true;
                                        clicked => {
                                            sender-card.close();
                                            root.email-sender();
                                        }
                                    }
                                    ToolButton {
                                        icon: root.reader.contact ? Icons.person : Icons.person-add;
                                        label: root.reader.contact ? "Show contact" : "Add to contacts";
                                        clicked => {
                                            sender-card.close();
                                            if (root.reader.contact) {
                                                root.show-sender();
                                            } else {
                                                root.add-sender();
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                VerticalLayout {
                    spacing: 2px;
                    HorizontalLayout {
                        spacing: 8px;
                        HorizontalLayout {
                            horizontal-stretch: 1;
                            alignment: start;
                            Text {
                                text: root.reader.sender;
                                font-weight: 600;
                                color: sender-touch.has-hover ? Theme.link : Theme.text;
                                overflow: elide;
                                min-width: min(self.preferred-width, 80px);
                                sender-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { sender-card.show(); }
                                }
                            }
                        }
                        Text {
                            text: root.reader.date;
                            color: Theme.text-muted;
                            font-size: Theme.small;
                            vertical-alignment: center;
                        }
                    }
                    if root.reader.sender-address != root.reader.sender: Text {
                        text: root.reader.sender-address;
                        color: Theme.text-muted;
                        font-size: Theme.small + 1px;
                        overflow: elide;
                    }
                    Text {
                        text: "To: " + root.reader.to;
                        color: Theme.text-muted;
                        font-size: Theme.small + 1px;
                        overflow: elide;
                    }
                    if root.reader.cc != "": Text {
                        text: "Cc: " + root.reader.cc;
                        color: Theme.text-muted;
                        font-size: Theme.small + 1px;
                        overflow: elide;
                    }
                    if root.reader.categories != "": Text {
                        text: root.reader.categories;
                        color: Theme.accent;
                        font-size: Theme.small;
                    }
                }
            }
            if root.reader.remote-images && !root.reader.images-shown: Rectangle {
                height: 32px;
                border-radius: Theme.radius;
                background: Theme.surface-alt;
                border-width: 1px;
                border-color: Theme.divider;
                HorizontalLayout {
                    padding-left: 10px;
                    spacing: 8px;
                    Icon {
                        y: (parent.height - self.height) / 2;
                        icon: Icons.image;
                        width: 16px;
                        height: 16px;
                    }
                    Text {
                        text: "Pictures from the internet were blocked to protect your privacy.";
                        color: Theme.text-muted;
                        font-size: Theme.small + 1px;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    ToolButton {
                        y: (parent.height - self.height) / 2;
                        label: "Show pictures";
                        tint: Theme.accent;
                        clicked => { root.show-images(); }
                    }
                }
            }
            if root.attachments.length > 0: Flickable {
                height: 40px;
                content-width: chips.preferred-width;
                chips := HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    for attachment in root.attachments: Rectangle {
                        height: 36px;
                        border-radius: Theme.radius;
                        border-width: 1px;
                        border-color: Theme.divider;
                        background: chip-touch.has-hover ? Theme.hover : Theme.surface-alt;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 2px;
                            spacing: 6px;
                            Icon {
                                y: (parent.height - self.height) / 2;
                                icon: Icons.attach;
                                width: 16px;
                                height: 16px;
                            }
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: attachment.name;
                                    color: Theme.text;
                                    font-size: Theme.small + 1px;
                                    overflow: elide;
                                    max-width: 220px;
                                }
                                Text {
                                    text: attachment.size;
                                    color: Theme.text-faint;
                                    font-size: Theme.small - 1px;
                                }
                            }
                            IconButton {
                                y: (parent.height - self.height) / 2;
                                icon: Icons.download;
                                tooltip: "Save to Downloads";
                                size: 28px;
                                icon-size: 16px;
                                clicked => { root.save-attachment(attachment.id); }
                            }
                        }
                        chip-touch := TouchArea {
                            width: parent.width - 30px;
                            x: 0;
                            mouse-cursor: pointer;
                            clicked => { root.open-attachment(attachment.id); }
                        }
                    }
                }
            }
        }
        Divider { }
        if root.reader.loading: HorizontalLayout {
            alignment: center;
            padding: 24px;
            Spinner {
                width: 24px;
                height: 24px;
                indeterminate: true;
            }
        }
        if root.original && root.page && !root.select-text: PageView {
            vertical-stretch: 1;
            picture: root.page-picture;
            page-width: root.page-width;
            page-height: root.page-height;
            view(width, height, x, y) => { root.page-view(width, height, x, y); }
            clicked(x, y) => { root.page-clicked(x, y); }
            over-link(x, y) => { return root.page-over-link(x, y); }
        }
        if root.original && root.webview && !root.select-text: web-area := Rectangle {
            vertical-stretch: 1;
            background: Theme.surface;
            Text {
                text: "Loading the original…";
                color: Theme.text-faint;
            }
            property <length> left: self.absolute-position.x;
            property <length> top: self.absolute-position.y;
            init => { root.original-area(self.left, self.top, self.width, self.height); }
            changed left => { root.original-area(self.left, self.top, self.width, self.height); }
            changed top => { root.original-area(self.left, self.top, self.width, self.height); }
            changed width => { root.original-area(self.left, self.top, self.width, self.height); }
            changed height => { root.original-area(self.left, self.top, self.width, self.height); }
        }
        if !root.reader.loading && !root.select-text && !(root.original && (root.page || root.webview)): BodyView {
            blocks: root.blocks;
            vertical-stretch: 1;
            link-clicked(link) => { root.link-clicked(link); }
        }
        if !root.reader.loading && root.select-text: TextEdit {
            text: root.reader.plain;
            read-only: true;
            wrap: word-wrap;
            vertical-stretch: 1;
        }
        if root.reader.truncated && !(root.original && root.page): Text {
            text: "This message is long; open the original to see all of it.";
            color: Theme.text-muted;
            horizontal-alignment: center;
            height: 28px;
        }
    }
}

// A text area for markdown, whose selection the formatting buttons work on.
component MarkdownEditor inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    // kind, text, anchor, cursor: see editor.rs.
    callback format(string, string, int, int) -> FormatResult;
    callback send();
    property <FormatResult> result;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.divider;
    background: Theme.surface;

    public function apply(kind: string) {
        root.result = root.format(kind, input.text, input.anchor-position-byte-offset, input.cursor-position-byte-offset);
        input.text = root.result.text;
        input.set-selection-offsets(root.result.anchor, root.result.cursor);
        input.focus();
    }

    public function focus-start() {
        input.focus();
        input.set-selection-offsets(0, 0);
    }

    flick := Flickable {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        content-width: self.width;
        content-height: max(self.height, input.preferred-height + 24px);
        // Clicks below the text put the cursor at its end.
        TouchArea {
            clicked => { input.focus(); }
        }
        input := TextInput {
            x: 12px;
            y: 12px;
            width: flick.width - 24px;
            single-line: false;
            wrap: word-wrap;
            color: Theme.text;
            font-size: Theme.font-size;
            selection-background-color: Theme.selected-strong;
            key-pressed(event) => {
                if (event.modifiers.control && event.text == Key.Return) {
                    root.send();
                    return accept;
                }
                if (event.modifiers.control && !event.modifiers.shift) {
                    if (event.text == "b") { root.apply("bold"); return accept; }
                    if (event.text == "i") { root.apply("italic"); return accept; }
                    if (event.text == "k") { root.apply("link"); return accept; }
                }
                reject
            }
            // Keeps the cursor in view while typing.
            cursor-position-changed(position) => {
                if (position.y + 40px > -flick.content-y + flick.height) {
                    flick.content-y = -(position.y + 40px - flick.height);
                }
                if (position.y < -flick.content-y) {
                    flick.content-y = -position.y;
                }
            }
        }
        if input.text == "": Text {
            x: 12px;
            y: 12px;
            text: root.placeholder;
            color: Theme.text-faint;
            font-size: Theme.font-size;
        }
    }
}

export component ComposePane inherits Rectangle {
    in-out property <Compose> compose;
    // "Name <address>" of each account, for the From box.
    in property <[string]> account-labels;
    in property <[AttachmentRow]> attachments;
    in property <[Suggestion]> suggestions;
    // Which field the suggestions are for: 0 to, 1 cc, 2 bcc.
    in property <int> suggestion-field;
    // The suggestion Enter or Tab picks, and whether Escape put them away.
    property <int> highlighted;
    property <bool> suggestions-dismissed;
    changed suggestions => {
        root.highlighted = 0;
        root.suggestions-dismissed = false;
    }
    property <bool> suggesting: !root.suggestions-dismissed && root.suggestions.length > 0
        && ((root.suggestion-field == 0 && to-field.focused)
            || (root.suggestion-field == 1 && cc-field.focused)
            || (root.suggestion-field == 2 && bcc-field.focused));

    function pick(index: int) {
        if (root.suggestion-field == 0) {
            root.compose.to = root.suggestion-picked(0, root.compose.to, root.suggestions[index].label);
            to-field.cursor-to-end();
        } else if (root.suggestion-field == 1) {
            root.compose.cc = root.suggestion-picked(1, root.compose.cc, root.suggestions[index].label);
            cc-field.cursor-to-end();
        } else if (root.suggestion-field == 2) {
            root.compose.bcc = root.suggestion-picked(2, root.compose.bcc, root.suggestions[index].label);
            bcc-field.cursor-to-end();
        }
    }

    // Keys from a recipient field, for the suggestions under it.
    function navigate(field: int, key: string) -> bool {
        if (!root.suggesting || field != root.suggestion-field) {
            return false;
        }
        if (key == "down") {
            root.highlighted = root.highlighted + 1 >= root.suggestions.length ? 0 : root.highlighted + 1;
            return true;
        }
        if (key == "up") {
            root.highlighted = root.highlighted <= 0 ? root.suggestions.length - 1 : root.highlighted - 1;
            return true;
        }
        if (key == "enter" || key == "tab") {
            root.pick(root.highlighted);
            return true;
        }
        if (key == "escape") {
            root.suggestions-dismissed = true;
            return true;
        }
        false
    }
    callback send(Compose);
    callback discard();
    callback save-draft(Compose);
    callback attach();
    callback remove-attachment(string);
    callback address-typed(int, string);
    callback suggestion-picked(int, string, string) -> string;
    callback format(string, string, int, int) -> FormatResult;
    // Fills preview-blocks from the markdown.
    callback preview(string);
    in property <[BodyBlock]> preview-blocks;
    background: Theme.surface;

    in property <int> focus-request;
    changed focus-request => { root.focus-first(); }
    init => { root.focus-first(); }
    // New messages start at the recipients, replies at the text.
    function focus-first() {
        if (root.compose.kind == 0 || root.compose.kind == 3) {
            to-field.focus-input();
        } else {
            body.focus-start();
        }
    }

    // Labels go when the pane is too narrow for them; told by the window,
    // as what the toolbar needs would otherwise decide the pane's width.
    in property <bool> compact;

    VerticalLayout {
        HorizontalLayout {
            padding: 6px;
            spacing: 4px;
            height: 44px;
            ToolButton {
                icon: Icons.send;
                label: root.compose.sending ? "Sending…" : "Send";
                tooltip: "Send (Ctrl+Enter)";
                primary: true;
                enabled: !root.compose.sending;
                clicked => {
                    root.send(root.compose);
                }
            }
            ToolButton {
                icon: Icons.attach;
                label: "Attach";
                compact: root.compact;
                clicked => { root.attach(); }
            }
            ToolButton {
                icon: Icons.important;
                label: "Important";
                tooltip: root.compose.important ? "Sent with high importance" : "Send with high importance";
                tint: root.compose.important ? Theme.danger : Theme.text;
                active: root.compose.important;
                compact: root.compact;
                clicked => { root.compose.important = !root.compose.important; }
            }
            Rectangle { horizontal-stretch: 1; }
            ToolButton {
                label: "Save draft";
                enabled: !root.compose.sending;
                clicked => { root.save-draft(root.compose); }
            }
            ToolButton {
                icon: Icons.delete;
                label: "Discard";
                compact: root.compact;
                clicked => { root.discard(); }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Panes.reading-only ? Icons.exit-full-view : Icons.full-view;
                tooltip: Panes.reading-only ? "Show folders and messages (Esc)" : "Write in full window";
                active: Panes.reading-only;
                clicked => { Panes.reading-only = !Panes.reading-only; }
            }
        }
        Divider { }
        VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 6px;
            spacing: 0px;
            if root.account-labels.length > 1: HorizontalLayout {
                height: 40px;
                spacing: 8px;
                Text {
                    width: 64px;
                    text: "From";
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
                ComboBox {
                    y: (parent.height - self.height) / 2;
                    model: root.account-labels;
                    current-index <=> root.compose.account-index;
                }
            }
            HorizontalLayout {
                spacing: 4px;
                to-field := Field {
                    label: "To";
                    text <=> root.compose.to;
                    placeholder: "Names or addresses, separated by ;";
                    edited(text) => { root.address-typed(0, text); }
                    navigate(key) => { return root.navigate(0, key); }
                }
                if !root.compose.show-cc: ToolButton {
                    y: (parent.height - self.height) / 2;
                    label: "Cc / Bcc";
                    tint: Theme.text-muted;
                    clicked => { root.compose.show-cc = true; }
                }
            }
            // Always there, so the suggestions can be placed under them.
            cc-field := Field {
                label: "Cc";
                text <=> root.compose.cc;
                visible: root.compose.show-cc;
                height: root.compose.show-cc ? 36px : 0px;
                edited(text) => { root.address-typed(1, text); }
                navigate(key) => { return root.navigate(1, key); }
            }
            bcc-field := Field {
                label: "Bcc";
                text <=> root.compose.bcc;
                visible: root.compose.show-cc;
                height: root.compose.show-cc ? 36px : 0px;
                edited(text) => { root.address-typed(2, text); }
                navigate(key) => { return root.navigate(2, key); }
            }
            Field {
                label: "Subject";
                text <=> root.compose.subject;
            }
            if root.attachments.length > 0: Flickable {
                height: 40px;
                content-width: attached.preferred-width;
                attached := HorizontalLayout {
                    padding-top: 4px;
                    spacing: 8px;
                    alignment: start;
                    for attachment in root.attachments: Rectangle {
                        height: 32px;
                        border-radius: Theme.radius;
                        border-width: 1px;
                        border-color: Theme.divider;
                        background: Theme.surface-alt;
                        HorizontalLayout {
                            padding-left: 8px;
                            spacing: 6px;
                            Icon {
                                y: (parent.height - self.height) / 2;
                                icon: Icons.attach;
                                width: 14px;
                                height: 14px;
                            }
                            Text {
                                text: attachment.name + "  " + attachment.size;
                                color: Theme.text;
                                font-size: Theme.small + 1px;
                                vertical-alignment: center;
                            }
                            IconButton {
                                y: (parent.height - self.height) / 2;
                                icon: Icons.close;
                                tooltip: "Remove";
                                size: 26px;
                                icon-size: 14px;
                                clicked => { root.remove-attachment(attachment.id); }
                            }
                        }
                    }
                }
            }
        }
        // Formatting.
        HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 4px;
            padding-bottom: 4px;
            spacing: 2px;
            IconButton { icon: Icons.bold; tooltip: "Bold (Ctrl+B)"; enabled: !root.compose.preview; clicked => { body.apply("bold"); } }
            IconButton { icon: Icons.italic; tooltip: "Italic (Ctrl+I)"; enabled: !root.compose.preview; clicked => { body.apply("italic"); } }
            IconButton { icon: Icons.strike; tooltip: "Strikethrough"; enabled: !root.compose.preview; clicked => { body.apply("strike"); } }
            IconButton { icon: Icons.bullets; tooltip: "Bulleted list"; enabled: !root.compose.preview; clicked => { body.apply("bullets"); } }
            IconButton { icon: Icons.numbers; tooltip: "Numbered list"; enabled: !root.compose.preview; clicked => { body.apply("numbers"); } }
            IconButton { icon: Icons.quote; tooltip: "Quote"; enabled: !root.compose.preview; clicked => { body.apply("quote"); } }
            IconButton { icon: Icons.link; tooltip: "Link (Ctrl+K)"; enabled: !root.compose.preview; clicked => { body.apply("link"); } }
            Rectangle { horizontal-stretch: 1; }
            ToolButton {
                icon: Icons.preview;
                label: "Preview";
                compact: root.compact;
                active: root.compose.preview;
                tint: root.compose.preview ? Theme.accent : Theme.text;
                clicked => {
                    root.compose.preview = !root.compose.preview;
                    if (root.compose.preview) {
                        root.preview(root.compose.body);
                    }
                }
            }
        }
        Rectangle {
            vertical-stretch: 1;
            body := MarkdownEditor {
                text <=> root.compose.body;
                placeholder: "Write your message. **bold**, *italic*, - lists and > quotes work as in markdown.";
                format(kind, text, anchor, cursor) => { root.format(kind, text, anchor, cursor) }
                send => { root.send(root.compose); }
            }
            if root.compose.preview: Rectangle {
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.divider;
                BodyView {
                    y: 10px;
                    height: parent.height - 10px;
                    blocks: root.preview-blocks;
                }
            }
        }
        if root.compose.quote != "": Rectangle {
            height: min(180px, quote-text.preferred-height + 20px);
            background: Theme.surface-alt;
            clip: true;
            quote-text := Text {
                x: 20px;
                y: 10px;
                width: parent.width - 40px;
                text: root.compose.quote;
                color: Theme.text-muted;
                font-size: Theme.small + 1px;
                wrap: word-wrap;
                vertical-alignment: top;
            }
        }
    }

    // People matching what is typed, under the field.
    if root.suggesting: Rectangle {
        property <length> field-bottom: (root.suggestion-field == 0 ? to-field.absolute-position.y + to-field.height
            : root.suggestion-field == 1 ? cc-field.absolute-position.y + cc-field.height
            : bcc-field.absolute-position.y + bcc-field.height) - root.absolute-position.y;
        x: 84px;
        y: self.field-bottom + 2px;
        width: min(440px, root.width - self.x - 16px);
        height: people.preferred-height;
        background: Theme.surface;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.divider;
        drop-shadow-blur: 16px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #00000030;
        people := VerticalLayout {
            padding: 4px;
            for person[index] in root.suggestions: Rectangle {
                height: 44px;
                border-radius: Theme.radius;
                background: index == root.highlighted ? Theme.selected : transparent;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 10px;
                    Avatar {
                        y: (parent.height - self.height) / 2;
                        initials: person.initials;
                        hue: person.hue;
                        picture: person.picture;
                        size: 30px;
                    }
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: person.name != "" ? person.name : person.address;
                            color: Theme.text;
                            overflow: elide;
                        }
                        if person.name != "": Text {
                            text: person.address;
                            color: Theme.text-muted;
                            font-size: Theme.small;
                            overflow: elide;
                        }
                    }
                }
                TouchArea {
                    mouse-cursor: pointer;
                    moved => { root.highlighted = index; }
                    changed has-hover => {
                        if (self.has-hover) {
                            root.highlighted = index;
                        }
                    }
                    clicked => { root.pick(index); }
                }
            }
        }
    }
}
