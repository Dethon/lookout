// Colours, metrics and vector icons shared by every component.

export global Theme {
    in-out property <bool> dark: false;

    out property <color> background: dark ? #1b1b1d : #f5f5f5;
    // A shade off the background, to make Slint repaint the whole window.
    out property <color> background-nudged: dark ? #1b1b1e : #f5f5f4;
    out property <color> surface: dark ? #242427 : #ffffff;
    out property <color> surface-alt: dark ? #2b2b2f : #fafafa;
    out property <color> hover: dark ? #323237 : #ebebeb;
    out property <color> selected: dark ? #2f3a4f : #dce8fa;
    out property <color> selected-strong: dark ? #36486a : #c7dcf7;
    out property <color> divider: dark ? #ffffff14 : #00000014;
    out property <color> text: dark ? #f1f1f3 : #1f1f1f;
    out property <color> text-muted: dark ? #b0b0b8 : #5c5c5c;
    out property <color> text-faint: dark ? #808088 : #8a8a8a;
    out property <color> accent: dark ? #6aa5f5 : #0f6cbd;
    out property <color> accent-hover: dark ? #8bb9f7 : #115ea3;
    out property <color> on-accent: #ffffff;
    out property <color> danger: dark ? #f1707b : #c4314b;
    out property <color> flag: #c4314b;
    out property <color> quote-bar: dark ? #5a5a62 : #c8c8c8;
    out property <color> link: dark ? #8ab4f8 : #0f6cbd;
    out property <color> rail: dark ? #161618 : #ebebeb;
    out property <color> overlay: #00000060;
    // People's initials are drawn in one of these, picked from their address.
    out property <[color]> person-colors: dark
        ? [#6aa5f5, #b49ae0, #e36fd2, #f1707b, #f29a63, #8fcf4d, #4cc2c4, #8c9ef7, #c39ce6, #e0b44c]
        : [#0f6cbd, #8764b8, #b4009e, #c50f1f, #ca5010, #498205, #038387, #4f6bed, #5c2e91, #986f0b];

    out property <length> radius: 6px;
    out property <length> font-size: 14px;
    out property <length> small: 12px;
    out property <length> row-height: 72px;
}

