// Small building blocks used throughout.

import { Theme } from "theme.slint";

// The tooltip shown for the control under the pointer; drawn by the window.
export global Tip {
    in-out property <string> text;
    // Where it points: the bottom centre of the control.
    in-out property <length> x;
    in-out property <length> y;
}

export component Icon inherits Path {
    in property <string> icon;
    in property <color> color: Theme.text-muted;
    commands: icon;
    fill: color;
    viewbox-width: 24;
    viewbox-height: 24;
    width: 18px;
    height: 18px;
}

// A square button showing only an icon.
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <color> tint: Theme.text-muted;
    in property <bool> active;
    in property <bool> enabled: true;
    in property <length> size: 32px;
    in property <length> icon-size: 18px;
    // Shown after a moment under the pointer.
    in property <string> tooltip;
    callback clicked();
    width: size;
    height: size;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: Theme.radius;
    background: touch.pressed ? Theme.selected-strong : (touch.has-hover && enabled) || active ? Theme.hover : transparent;
    opacity: enabled ? 1 : 0.4;
    Icon {
        icon: root.icon;
        color: root.active ? Theme.accent : root.tint;
        width: root.icon-size;
        height: root.icon-size;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            Tip.text = "";
            root.clicked();
        }
    }
    // Once per visit of the pointer.
    property <bool> tip-shown;
    Timer {
        interval: 600ms;
        running: touch.has-hover && root.tooltip != "" && !root.tip-shown;
        triggered => {
            root.tip-shown = true;
            Tip.x = root.absolute-position.x + root.width / 2;
            Tip.y = root.absolute-position.y + root.height;
            Tip.text = root.tooltip;
        }
    }
    property <bool> hovered: touch.has-hover;
    changed hovered => {
        if (!self.hovered) {
            root.tip-shown = false;
            if (Tip.text == root.tooltip) {
                Tip.text = "";
            }
        }
    }
}

// An icon with a label, for toolbars.
export component ToolButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <color> tint: Theme.text;
    in property <bool> enabled: true;
    in property <bool> primary;
    // A switch that is on.
    in property <bool> active;
    callback clicked();
    height: 32px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: Theme.radius;
    background: primary ? (touch.has-hover ? Theme.accent-hover : Theme.accent)
        : touch.pressed || active ? Theme.selected-strong : touch.has-hover && enabled ? Theme.hover : transparent;
    opacity: enabled ? 1 : 0.4;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 6px;
        alignment: start;
        if root.icon != "": Icon {
            y: (parent.height - self.height) / 2;
            icon: root.icon;
            color: root.primary ? Theme.on-accent : root.tint;
        }
        Text {
            text: root.label;
            color: root.primary ? Theme.on-accent : root.tint;
            font-size: Theme.font-size;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component Avatar inherits Rectangle {
    in property <string> initials;
    in property <length> size: 36px;
    in property <color> tint: Theme.accent;
    width: size;
    height: size;
    border-radius: size / 2;
    background: tint.with-alpha(0.18);
    Text {
        text: root.initials;
        color: root.tint;
        font-size: root.size * 0.38;
        font-weight: 600;
    }
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.divider;
}

export component VDivider inherits Rectangle {
    width: 1px;
    background: Theme.divider;
}

// A labelled single-line field, styled to match the panes.
export component Field inherits Rectangle {
    in property <string> label;
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    in property <bool> read-only;
    in property <length> label-width: 64px;
    callback edited(string);
    callback accepted();
    height: 36px;
    HorizontalLayout {
        spacing: 8px;
        if root.label != "": Text {
            width: root.label-width;
            text: root.label;
            color: Theme.text-muted;
            vertical-alignment: center;
            font-size: Theme.font-size;
        }
        Rectangle {
            input := TextInput {
                y: 0;
                width: 100%;
                height: 100%;
                vertical-alignment: center;
                color: Theme.text;
                font-size: Theme.font-size;
                read-only: root.read-only;
                single-line: true;
                selection-background-color: Theme.selected-strong;
                edited => { root.edited(self.text); }
                accepted => { root.accepted(); }
            }
            if input.text == "" && root.placeholder != "": Text {
                x: 0;
                text: root.placeholder;
                color: Theme.text-faint;
                font-size: Theme.font-size;
                vertical-alignment: center;
            }
        }
    }
    Divider {
        y: parent.height - 1px;
        background: input.has-focus ? Theme.accent : Theme.divider;
    }
    public function focus-input() {
        input.focus();
    }
}

// A search box with a magnifier and a clear button.
export component SearchBox inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder: "Search";
    callback edited(string);
    callback accepted(string);
    height: 32px;
    border-radius: Theme.radius;
    background: Theme.surface-alt;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.divider;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 4px;
        spacing: 6px;
        Icon {
            y: (parent.height - self.height) / 2;
            icon: "M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z";
            width: 16px;
            height: 16px;
        }
        Rectangle {
            input := TextInput {
                y: 0;
                width: 100%;
                height: 100%;
                vertical-alignment: center;
                color: Theme.text;
                font-size: Theme.font-size;
                single-line: true;
                edited => { root.edited(self.text); }
                accepted => { root.accepted(self.text); }
            }
            if input.text == "": Text {
                x: 0;
                text: root.placeholder;
                color: Theme.text-faint;
                font-size: Theme.font-size;
                vertical-alignment: center;
            }
        }
        if input.text != "": IconButton {
            y: (parent.height - self.height) / 2;
            icon: "M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z";
            size: 24px;
            icon-size: 14px;
            tooltip: "Clear";
            clicked => {
                input.text = "";
                root.edited("");
            }
        }
    }
    public function focus-input() {
        input.focus();
    }
}

// A dimmed backdrop with a centred card, for dialogs.
export component Overlay inherits Rectangle {
    in property <length> card-width: 480px;
    in property <length> card-height: 0px;
    callback dismissed();
    background: Theme.overlay;
    TouchArea {
        clicked => { root.dismissed(); }
    }
    Rectangle {
        width: min(root.card-width, root.width - 32px);
        height: root.card-height > 0 ? min(root.card-height, root.height - 32px) : self.preferred-height;
        background: Theme.surface;
        border-radius: 8px;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000040;
        // Clicks on the card stay on it.
        TouchArea { }
        @children
    }
}
